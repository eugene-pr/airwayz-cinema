# Working dev values. Host-side scripts (npm run migrate/seed) read this file,
# then .env if present. Compose reads the same files but points DATABASE_URL
# at the `db` service (docker-compose.yml).
DATABASE_URL=postgres://cinema:cinema@localhost:5432/cinema
JWT_SECRET=dev-only-jwt-secret-not-for-production-use
LOG_LEVEL=info
